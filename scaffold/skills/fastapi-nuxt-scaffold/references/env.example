APP_NAME=__APP_NAME__
DEBUG=0

DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=__APP_NAME__
TEST_DB_NAME=<$DB_NAME>_test
# hyphens need quoting, and appName is conventionally kebab-case. Rename the DB yourself.

# python -c "import secrets; print(secrets.token_urlsafe(64))"
TOKEN_KEY=
ACCESS_TOKEN_EXP_MINUTES=30
REFRESH_TOKEN_EXP_DAYS=30
REFRESH_TOKEN_IDLE_DAYS=7
RECOVERY_TOKEN_EXP_MINUTES=30

# COOKIE_SECURE=0 only because local dev is plain http. Never 0 in a deployed environment.
COOKIE_SECURE=0
COOKIE_SAMESITE=lax

FRONTEND_BASE_URL=http://localhost:3000
REST_CORS_ORIGINS=http://localhost:3000
API_KEYS=dev-local-key

# Mail settings -- invite and 2FA-code emails. Leave MAIL_SERVER unreachable in local dev:
# sending is best-effort (see lib/mail.py) and the invite endpoint returns the link anyway.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=__APP_NAME__
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_STARTTLS=0
MAIL_SSL_TLS=0
MAIL_USE_CREDENTIALS=0
MAIL_VALIDATE_CERTS=0
MAIL_TIMEOUT=10
